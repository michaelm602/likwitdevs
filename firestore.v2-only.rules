rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {
    function isOwner() {
      return request.auth != null &&
             request.auth.uid in ['7u3Uund1CKRrtf4Pw0ehaLCI7WR2'];
    }

    function isAllowedAcquisitionSource(value) {
      return value in [
        "Facebook", "Instagram", "Google Organic", "Google Ads", "Direct",
        "Referral", "Email", "QR", "NFC", "Outreach Audit",
        "Other Campaign", "Unknown"
      ];
    }

    function isPublicEventName(value) {
      return value in [
        "page_view", "cta_click", "contact_form_started",
        "contact_form_submitted", "lead_created", "emailjs_sent",
        "emailjs_failed", "lead_create_failed", "service_card_click",
        "service_problem_click", "project_case_study_click",
        "project_live_site_click"
      ];
    }

    function isAdminOperationalEventName(value) {
      return value in [
        "admin_lead_status_changed",
        "admin_lead_note_updated",
        "admin_proposal_generated"
      ];
    }

    function isValidMetadata(value) {
      return value is map
        && value.keys().hasOnly([
          "source", "projectType", "location", "label", "title", "solution",
          "serviceId", "serviceTitle", "status", "hasNotes", "noteLength",
          "recommendedPackage", "price", "depositPercentage", "hasWebsite",
          "hasIndustry", "hasIntent"
        ])
        && (!value.keys().hasAny(["source"]) || value.source is string)
        && (!value.keys().hasAny(["projectType"]) || value.projectType is string)
        && (!value.keys().hasAny(["location"]) || value.location is string)
        && (!value.keys().hasAny(["label"]) || value.label is string)
        && (!value.keys().hasAny(["title"]) || value.title is string)
        && (!value.keys().hasAny(["solution"]) || value.solution is string)
        && (!value.keys().hasAny(["serviceId"]) || value.serviceId is string)
        && (!value.keys().hasAny(["serviceTitle"]) || value.serviceTitle is string)
        && (!value.keys().hasAny(["status"]) || value.status is string)
        && (!value.keys().hasAny(["hasNotes"]) || value.hasNotes is bool)
        && (!value.keys().hasAny(["noteLength"]) || value.noteLength is int)
        && (!value.keys().hasAny(["recommendedPackage"]) || value.recommendedPackage is string)
        && (!value.keys().hasAny(["price"]) || value.price is string)
        && (!value.keys().hasAny(["depositPercentage"]) || value.depositPercentage is number)
        && (!value.keys().hasAny(["hasWebsite"]) || value.hasWebsite is bool)
        && (!value.keys().hasAny(["hasIndustry"]) || value.hasIndustry is bool)
        && (!value.keys().hasAny(["hasIntent"]) || value.hasIntent is bool);
    }

    function isValidAttribution(value) {
      return value is map
        && value.keys().hasOnly([
          "acquisitionSource", "landingPage", "landingPath", "referrer",
          "utmSource", "utmMedium", "utmCampaign", "utmContent", "utmTerm",
          "fbclid", "gclid"
        ])
        && isAllowedAcquisitionSource(value.acquisitionSource)
        && value.landingPage is string
        && value.landingPath is string
        && value.referrer is string
        && value.utmSource is string
        && value.utmMedium is string
        && value.utmCampaign is string
        && value.utmContent is string
        && value.utmTerm is string
        && value.fbclid is string
        && value.gclid is string;
    }

    function hasValidV2AnalyticsShape() {
      return request.resource.data.keys().hasOnly([
          "schemaVersion", "releaseId", "eventCategory", "isPublicTraffic",
          "hostname", "eventName", "canonicalPath", "pagePath", "sourcePage",
          "targetPath", "targetUrl", "projectSlug", "projectName",
          "serviceIntent", "leadId", "originPage", "landingPage", "referrer",
          "firstTouch", "latestTouch", "acquisitionSource",
          "conversionLocation", "submissionSurface", "metadata", "createdAt",
          "sessionId"
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.releaseId is string
        && request.resource.data.hostname in ["likwitdevs.com", "www.likwitdevs.com"]
        && request.resource.data.eventName is string
        && request.resource.data.canonicalPath is string
        && request.resource.data.pagePath is string
        && request.resource.data.sourcePage is string
        && request.resource.data.targetPath is string
        && request.resource.data.targetUrl is string
        && request.resource.data.projectSlug is string
        && request.resource.data.projectName is string
        && request.resource.data.serviceIntent is string
        && request.resource.data.leadId is string
        && request.resource.data.originPage is string
        && request.resource.data.landingPage is string
        && request.resource.data.referrer is string
        && isValidAttribution(request.resource.data.firstTouch)
        && isValidAttribution(request.resource.data.latestTouch)
        && isAllowedAcquisitionSource(request.resource.data.acquisitionSource)
        && request.resource.data.acquisitionSource ==
           request.resource.data.firstTouch.acquisitionSource
        && request.resource.data.landingPage ==
           request.resource.data.firstTouch.landingPage
        && request.resource.data.conversionLocation is string
        && request.resource.data.submissionSurface is string
        && isValidMetadata(request.resource.data.metadata)
        && request.resource.data.createdAt == request.time
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0;
    }

    function isValidV2PublicAnalyticsEvent() {
      return hasValidV2AnalyticsShape()
        && request.resource.data.releaseId.size() > 0
        && request.resource.data.eventCategory == "public"
        && request.resource.data.isPublicTraffic == true
        && isPublicEventName(request.resource.data.eventName)
        && !request.resource.data.canonicalPath.matches('^/admin(/.*)?$');
    }

    function isValidV2AdminOperationalEvent() {
      return isOwner()
        && request.resource.data.eventCategory == "admin_operation"
        && request.resource.data.isPublicTraffic == false
        && isAdminOperationalEventName(request.resource.data.eventName)
        && hasValidV2AnalyticsShape();
    }

    function hasValidV2LeadShape() {
      return request.resource.data.keys().hasOnly([
          "name", "email", "replyTo", "website", "projectType", "rawIntent",
          "message", "rawMessage", "source", "sourcePage", "createdAt",
          "updatedAt", "status", "originPage", "landingPage", "referrer",
          "estimatedValue", "notes", "leadSource", "analyticsSchemaVersion",
          "analyticsReleaseId", "firstTouch", "latestTouch",
          "acquisitionSource", "selfReportedSource", "canonicalLandingPage",
          "conversionLocation", "submissionSurface"
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.replyTo is string
        && request.resource.data.website is string
        && request.resource.data.projectType is string
        && request.resource.data.rawIntent is string
        && request.resource.data.message is string
        && request.resource.data.rawMessage is string
        && request.resource.data.source is string
        && request.resource.data.sourcePage is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status == "New"
        && request.resource.data.originPage is string
        && request.resource.data.landingPage is string
        && request.resource.data.referrer is string
        && request.resource.data.estimatedValue == null
        && request.resource.data.notes == ""
        && request.resource.data.leadSource is string
        && request.resource.data.analyticsSchemaVersion == 2
        && request.resource.data.analyticsReleaseId is string
        && isValidAttribution(request.resource.data.firstTouch)
        && isValidAttribution(request.resource.data.latestTouch)
        && isAllowedAcquisitionSource(request.resource.data.acquisitionSource)
        && request.resource.data.acquisitionSource ==
           request.resource.data.firstTouch.acquisitionSource
        && request.resource.data.selfReportedSource is string
        && request.resource.data.selfReportedSource ==
           request.resource.data.leadSource
        && request.resource.data.canonicalLandingPage is string
        && request.resource.data.canonicalLandingPage ==
           request.resource.data.firstTouch.landingPage
        && request.resource.data.conversionLocation is string
        && request.resource.data.submissionSurface is string;
    }

    match /projects/{doc} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /leads/{leadId} {
      allow create: if hasValidV2LeadShape();
      allow read, update, delete: if isOwner();
    }

    match /analyticsEvents/{eventId} {
      allow create: if isValidV2AdminOperationalEvent() ||
                       isValidV2PublicAnalyticsEvent();
      allow read: if isOwner();
      allow update, delete: if false;
    }
  }
}
